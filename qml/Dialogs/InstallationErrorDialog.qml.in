import QtQuick 2.4
import Lomiri.Components @LOMIRI_COMPONENTS_VERSION@
import Lomiri.Components.Popups @LOMIRI_COMPONENTS_VERSION@
import OpenStore 1.0

Component {
    id: installationError

    Dialog {
        id: installationErrorDialog
        // Optional installer-specific detail appended to the generic message.
        property string message
        title: i18n.tr("Installation failed")
        text: i18n.tr("The package could not be installed.") + " " + (message || "")
        Button {
            color: theme.palette.normal.positive
            text: i18n.tr("OK")
            onClicked: PopupUtils.close(installationErrorDialog)
        }
    }
}
