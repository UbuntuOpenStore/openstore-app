import QtQuick 2.4
import Lomiri.Components @LOMIRI_COMPONENTS_VERSION@

Rectangle {
    id: root

    color: appColor

    signal installedAppsClicked()
    signal categoryClicked(var name, var id)

    // "installed", "category:<id>", or "" for the discover root.
    property string selectedSection: ""

    // Theme colors are inputs so Main.qml.in can override them. Defaults match Main.qml.in.
    property color appColor: "#292929"
    property color appColorText: LomiriColors.porcelain

    // Height of the brand row. Main.qml.in binds this to the current page
    // header height so the divider under the brand lines up with the header.
    // Default matches the Lomiri PageHeaderStyle height: content + divider.
    property real headerHeight: units.gu(6) + units.dp(1)

    function _isInstalledSelected() { return root.selectedSection === "installed"; }
    function _isCategorySelected(id) { return root.selectedSection === "category:" + id; }

    Column {
        id: headerColumn
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: root.headerHeight

        Item {
            width: parent.width
            height: parent.height

            Image {
                anchors.left: parent.left
                anchors.leftMargin: units.gu(2)
                anchors.verticalCenter: parent.verticalCenter
                source: Qt.resolvedUrl("../Assets/openstore.svg")
                sourceSize.width: units.gu(4)
                sourceSize.height: units.gu(4)
                width: units.gu(4)
                height: units.gu(4)
                fillMode: Image.PreserveAspectFit
            }

            Label {
                anchors.left: parent.left
                anchors.leftMargin: units.gu(8)
                anchors.verticalCenter: parent.verticalCenter
                text: "OpenStore"
                color: appColorText
                font.pixelSize: units.gu(2.2)
            }
        }

        Rectangle {
            anchors.bottom: parent.bottom
            width: parent.width
            height: units.dp(1)
            color: theme.palette.normal.base
        }
    }

    ListItem {
        id: installedAppsItem
        anchors.top: headerColumn.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: units.gu(7)
        divider.visible: true

        selected: root._isInstalledSelected()

        ListItemLayout {
            anchors.fill: parent

            title.text: i18n.tr("Installed Apps")
            title.color: appColorText
            ProgressionSlot {}
        }

        onClicked: root.installedAppsClicked()
    }

    ScrollView {
        anchors.top: installedAppsItem.bottom
        anchors.topMargin: units.gu(1)
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.bottomMargin: units.gu(1)

        LomiriListView {
            id: categoryList
            anchors.fill: parent
            model: categoriesModel
            // Sidebar uses each delegate's `selected:` binding for highlight;
            // list-level `currentIndex` would otherwise highlight the first
            // item by default (currentIndex: 0).
            currentIndex: -1

            // WORKAROUND: Fix for wrong grid unit size
            Component.onCompleted: root.flickable_responsive_scroll_fix(categoryList)

            // Empty-state placeholder until the categories model reports ready.
            Label {
                visible: !categoriesModel.ready || categoriesModel.rowCount() === 0
                anchors.centerIn: parent
                width: parent.width - units.gu(4)
                horizontalAlignment: Label.AlignHCenter
                wrapMode: Label.WordWrap
                text: i18n.tr("Loading categories...")
                color: appColorText
            }

            delegate: ListItem {
                width: ListView.view.width
                height: units.gu(4.5)
                divider.visible: false
                selected: root._isCategorySelected(model.id)

                ListItemLayout {
                    anchors.fill: parent

                    Image {
                        SlotsLayout.position: SlotsLayout.Leading
                        source: model.iconUrl
                        width: units.gu(2.5)
                        height: width
                        sourceSize: Qt.size(width, height)
                    }

                    title.text: model.name
                    title.color: appColorText
                }

                onClicked: root.categoryClicked(model.name, model.id)
            }
        }
    }
}
