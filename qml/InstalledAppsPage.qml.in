import QtQuick 2.4
import Lomiri.Components @LOMIRI_COMPONENTS_VERSION@
import Lomiri.Connectivity @LOMIRI_CONNECTIVITY_VERSION@
import OpenStore 1.0
import QtQuick.Layouts 1.1

import "Components" as Components
import Lomiri.Components.Popups @LOMIRI_COMPONENTS_VERSION@
import "Dialogs" as Dialogs

Page {
    id: rootItem
    objectName: "installedAppsPage"

    property var currentApp: null
    property var appsUpdating: []
    property var batchUpdating: []
    property bool batchRunning: false

    property bool updating: BackendInstaller.installer.busy || PackagesCache.updatingCache
    property int updatesCount: localAppModel.updatesAvailableCount + localAppModel.systemUpdatesCount
    property int installedAppsCount: localAppModel.count - localAppModel.updatesAvailableCount - localAppModel.downgradesAvailableCount - localAppModel.snapsCount

    function updateNextPackage() {
        //console.log('updateNextPackage', JSON.stringify(appsUpdating));

        if (batchRunning) {
            batchRunning = false;
            batchUpdating = [];
            return;
        }

        if (appsUpdating.length > 0) {
            var nextApp = appsUpdating.shift();
            currentApp = nextApp.appId;

            BackendInstaller.installer.installPackage(nextApp.packageUrl);
        }
    }

    function isUpdating(appId) {
        return updating && (currentApp == appId || batchUpdating.indexOf(appId) >= 0);
    }

    function updateAll() {
        var updates = [];
        for (var i = 0; i < localAppModel.count; i++) {
            var app = localAppModel.get(i);

            if (app && app.updateStatus == 'available' && app.packageUrl) {
                updates.push(app);
            }
        }

        if (PlatformIntegration.packageKit) {
            var appIds = [];
            for (var j = 0; j < updates.length; j++) {
                appIds.push(updates[j].appId);
            }

            if (appIds.length == 0 && localAppModel.systemUpdatesCount == 0)
                return;

            batchUpdating = appIds;
            batchRunning = true;
            PackageBackendManager.updateAll();
            return;
        }

        appsUpdating = updates;
        updateNextPackage();
    }

    Connections {
        target: BackendInstaller.installer
        onPackageInstalled: updateNextPackage()
        onPackageInstallationFailed: {
            // Stop the batch so the failure dialog isn't followed by more updates.
            appsUpdating = [];
            batchUpdating = [];
            batchRunning = false;
            currentApp = null;
        }
    }

    header: Components.HeaderMain {
        title: i18n.tr("Installed Apps")
        flickable: scrollView.flickableItem
    }

    ScrollView {
        id: scrollView
        width: parent.width
        anchors {
            top: parent.top
            bottom: parent.bottom
        }

        Component.onCompleted: root.flickable_responsive_scroll_fix(scrollView.flickableItem)

        Column {
            width: scrollView.width

            Components.SectionDivider {
                visible: rootItem.updatesCount > 0
                height: units.gu(6)
                // TRANSLATORS: %1 is the number of available updates
                text: i18n.tr("Available updates (%1)").arg(rootItem.updatesCount)
                buttonText: i18n.tr("Update all")
                buttonEnabled: !BackendInstaller.installer.busy

                onButtonClicked: rootItem.updateAll()
            }

            ListView {
                width: parent.width
                height: contentHeight
                interactive: false
                model: localAppModel.availableUpdatesModel
                delegate: appDelegate
            }

            // ListItem hides the divider of the last delegate, so the boundary before the system updates row needs an explicit line.
            Components.LineDivider {
                x: units.gu(8)
                width: parent.width - units.gu(8)
                visible: localAppModel.systemUpdatesCount > 0 && localAppModel.updatesAvailableCount > 0
            }

            ListItem {
                visible: localAppModel.systemUpdatesCount > 0
                width: parent.width
                height: units.gu(7)
                onClicked: PopupUtils.open(systemUpdatesDialog, rootItem, { updates: localAppModel.systemUpdates() })
                divider.visible: false

                ListItemLayout {
                    anchors.centerIn: parent
                    // TRANSLATORS: %1 is the number of library and tool updates
                    title.text: i18n.tr("%1 library and tool update", "%1 library and tool updates", localAppModel.systemUpdatesCount).arg(localAppModel.systemUpdatesCount)

                    Item {
                        SlotsLayout.position: SlotsLayout.Leading
                        width: units.gu(4); height: width

                        LomiriShape {
                            id: appIcon
                            anchors.fill: parent
                            opacity: batchRunning ? .2 : 1
                            aspect: LomiriShape.Flat
                            image: Image {
                                sourceSize.width: parent.width
                                sourceSize.height: parent.height
                                source: PlatformIntegration.fallbackIcon
                            }
                        }

                        ActivityIndicator {
                            width: parent.width - units.gu(1)
                            height: width
                            anchors.centerIn: parent
                            visible: batchRunning
                            running: visible
                        }
                    }

                    ProgressionSlot {
                        name: "next"
                    }
                }
            }

            Components.SectionDivider {
                visible: localAppModel.downgradesAvailableCount > 0
                height: units.gu(9)
                // TRANSLATORS: %1 is the number of apps that can be downgraded
                text: i18n.tr("Stable version available (%1)".arg(localAppModel.downgradesAvailableCount))
                subtext: i18n.tr("The installed versions of these apps did not come from the OpenStore but a stable version is available.")
            }

            ListView {
                width: parent.width
                height: contentHeight
                interactive: false
                model: localAppModel.downgradeAppsModel
                delegate: appDelegate
            }

            Components.SectionDivider {
                visible: rootItem.installedAppsCount > 0
                height: units.gu(6)
                // TRANSLATORS: %1 is the number of installed click apps
                text: i18n.tr("Installed apps (%1)").arg(rootItem.installedAppsCount)
            }

            ListView {
                width: parent.width
                height: contentHeight
                interactive: false
                model: localAppModel.installedAppsModel
                delegate: appDelegate
            }

            Components.SectionDivider {
                visible: localAppModel.snapsCount > 0
                height: units.gu(6)
                // TRANSLATORS: %1 is the number of installed snap apps
                text: i18n.tr("Installed Snap apps (%1)").arg(localAppModel.snapsCount)
            }

            ListView {
                width: parent.width
                height: contentHeight
                interactive: false
                model: localAppModel.snapAppsModel
                delegate: appDelegate
            }
        }
    }

    Component {
        id: appDelegate

        ListItem {
            height: units.gu(7)
            divider.anchors.leftMargin: units.gu(8)

            ListItemLayout {
                id: layout

                anchors {
                    horizontalCenter: parent.horizontalCenter
                    top: parent.top
                }

                title.text: model.name

                Item {
                    SlotsLayout.position: SlotsLayout.Leading
                    width: units.gu(4); height: width

                    LomiriShape {
                        id: appIcon
                        anchors.fill: parent
                        opacity: updateSpinner.visible ? .2 : 1
                        aspect: LomiriShape.Flat
                        image: Image {
                            sourceSize.width: parent.width
                            sourceSize.height: parent.height
                            source: model.icon
                        }
                    }

                    ActivityIndicator {
                        id: updateSpinner
                        width: parent.width - units.gu(1)
                        height: width
                        anchors.centerIn: parent
                        visible: isUpdating(model.appId)
                        running: visible
                    }
                }

                ProgressionSlot {
                    name: isUpdating(model.appId) ? "close" : "next"
                }
            }

            function slot_packageFetchError(appId) {
                PackageBackendManager.packageDetailsReady.disconnect(slot_installedPackageDetailsReady);
                PackageBackendManager.packageDetailsError.disconnect(slot_packageFetchError);

                if (root.mainStackPage !== "discoverPage") { pageStack.pop() }
                pageStack.push(Qt.resolvedUrl("AppLocalDetailsPage.qml"), {
                    app: localAppModel.getByAppId(appId),
                    localAppModel: localAppModel
                });
            }

            function slot_installedPackageDetailsReady(pkg) {
                PackageBackendManager.packageDetailsReady.disconnect(slot_installedPackageDetailsReady);
                PackageBackendManager.packageDetailsError.disconnect(slot_packageFetchError);

                if (root.mainStackPage !== "discoverPage") { pageStack.pop() }
                pageStack.push(Qt.resolvedUrl("AppDetailsPage.qml"), {
                    app: pkg,
                    localAppModel: localAppModel
                });
            }

            onClicked: {
                if (isUpdating(model.appId)) {
                    BackendInstaller.installer.abortInstallation()
                } else {
                    if (Connectivity.online || PlatformIntegration.packageKit) {
                        PackageBackendManager.packageDetailsReady.connect(slot_installedPackageDetailsReady);
                        PackageBackendManager.packageDetailsError.connect(slot_packageFetchError);
                        PackageBackendManager.getPackageDetails(model.appId);
                    }
                    else {
                        if (root.mainStackPage !== "discoverPage") { pageStack.pop() }
                        pageStack.push(Qt.resolvedUrl("AppLocalDetailsPage.qml"), {
                            app: localAppModel.getByAppId(model.appId),
                            localAppModel: localAppModel
                        });
                    }
                }
            }
        }
    }

    Loader {
        anchors.centerIn: parent
        active: localAppModel.count == 0
        sourceComponent: Components.EmptyState {
            title: i18n.tr("No apps found")
            subTitle: i18n.tr("No app has been installed from OpenStore yet.")
            iconName: "ubuntu-store-symbolic"
            anchors.centerIn: parent
        }
    }

    Dialogs.SystemUpdatesDialog {
        id: systemUpdatesDialog
    }
}
