import QtQuick 2.4
import Lomiri.Components @LOMIRI_COMPONENTS_VERSION@
import Lomiri.Components.Popups @LOMIRI_COMPONENTS_VERSION@
import OpenStore 1.0

Component {
    id: indexSetupComponent

    Dialog {
        id: indexSetupDialog
        title: i18n.tr("Setting up the app catalog")

        property var debIndex: PlatformIntegration.debSupport ? BackendInstaller.indexStatus : null

        Timer {
            id: startTimer
            interval: 100
            onTriggered: {
                if (debIndex && debIndex.state === "uninitialized") {
                    debIndex.initialize();
                }
            }
        }

        Component.onCompleted: {
            startTimer.start(); // Delay starting the timer so the UI has a chance to render
        }

        Connections {
            target: debIndex
            onReady: PopupUtils.close(indexSetupDialog)
            onStateChanged: {
                if (debIndex.state === "ready") {
                    PopupUtils.close(indexSetupDialog);
                }
            }
        }

        ActivityIndicator {
            anchors.horizontalCenter: parent.horizontalCenter
            running: debIndex ? debIndex.state === "initializing" : false
            visible: running
        }

        Label {
            anchors {
                left: parent.left
                right: parent.right
            }
            horizontalAlignment: Text.AlignHCenter
            text: debIndex && debIndex.state === "error"
                ? debIndex.errorMessage
                : i18n.tr("Building app index…")
            wrapMode: Text.WordWrap
            maximumLineCount: Number.MAX_VALUE
        }

        Button {
            anchors.horizontalCenter: parent.horizontalCenter
            visible: debIndex && debIndex.state === "error"
            text: i18n.tr("Retry")
            onClicked: debIndex.retry()
        }
    }
}
